{
  "version": 2,
  "source_path": "skills/engineering/improve-codebase-architecture",
  "rules": [
    {
      "id": "widen-scattered-scan-after-exploration",
      "when": {
        "user_named_direction": false,
        "hot_spot_found": false,
        "context_and_adrs_read": true,
        "exploration_completed": true
      },
      "requires_constraints": [
        "widen-scattered-scan",
        "read-domain-and-adrs-first",
        "explore-friction-before-candidates"
      ],
      "outcome": {
        "scan_scope": "widened",
        "may_recommend": true
      }
    },
    {
      "id": "reject-when-deletion-does-not-concentrate",
      "when": {
        "deletion_concentrates_complexity": false
      },
      "requires_constraints": [
        "deletion-test-signal"
      ],
      "outcome": {
        "recommendation": "reject",
        "reason": "deletion-does-not-concentrate-complexity"
      }
    },
    {
      "id": "present-report-before-interface-proposals",
      "when": {
        "candidate_passed_deletion_test": true,
        "report_written": true
      },
      "requires_constraints": [
        "fresh-temp-report",
        "before-after-visual",
        "ask-after-writing"
      ],
      "outcome": {
        "report_path": "tmpdir/architecture-review-<timestamp>.html",
        "includes_before_after_visual": true,
        "next_action": "ask-user-to-pick-candidate",
        "propose_interfaces": false
      }
    },
    {
      "id": "apply-selected-candidate-loop",
      "when": {
        "candidate_selected": true,
        "new_concept_not_in_context": true,
        "rejection_reason_load_bearing": true,
        "alternative_interfaces_requested": true
      },
      "requires_constraints": [
        "start-grilling-after-selection",
        "add-new-domain-term",
        "offer-adr-for-load-bearing-rejection",
        "explore-alternative-interfaces"
      ],
      "outcome": {
        "run_grilling": true,
        "update_context": true,
        "offer_adr": true,
        "run_codebase_design_twice": true
      }
    }
  ],
  "scenarios": [
    {
      "id": "exploration-before-recommendation",
      "input": {
        "user_named_direction": false,
        "hot_spot_found": false,
        "context_and_adrs_read": true,
        "exploration_completed": true
      },
      "retrieved_constraints": [
        {
          "id": "widen-scattered-scan",
          "document": "SKILL.md",
          "source_section": "SKILL.md#1. 探索",
          "text": "若变更分散且没有明显热点，就扩大范围。"
        },
        {
          "id": "read-domain-and-adrs-first",
          "document": "SKILL.md",
          "source_section": "SKILL.md#1. 探索",
          "text": "先阅读项目的领域词汇表（`CONTEXT.md`）以及所触及区域中的所有 ADR。"
        },
        {
          "id": "explore-friction-before-candidates",
          "document": "SKILL.md",
          "source_section": "SKILL.md#1. 探索",
          "text": "自然地探索，并记录你在哪里感到理解摩擦"
        }
      ],
      "expected": {
        "scan_scope": "widened",
        "may_recommend": true
      }
    },
    {
      "id": "yagni-rejection",
      "input": {
        "deletion_concentrates_complexity": false
      },
      "retrieved_constraints": [
        {
          "id": "deletion-test-signal",
          "document": "SKILL.md",
          "source_section": "SKILL.md#1. 探索",
          "text": "“是，会集中”才是你要找的信号。"
        }
      ],
      "expected": {
        "recommendation": "reject",
        "reason": "deletion-does-not-concentrate-complexity"
      }
    },
    {
      "id": "report-recommendation",
      "input": {
        "candidate_passed_deletion_test": true,
        "report_written": true
      },
      "retrieved_constraints": [
        {
          "id": "fresh-temp-report",
          "document": "SKILL.md",
          "source_section": "SKILL.md#2. 将候选项呈现为 HTML 报告",
          "text": "先写入 `<tmpdir>/architecture-review-<timestamp>.content.md`，再由 frontend 阶段渲染同名 HTML。"
        },
        {
          "id": "conditional-visual",
          "document": "SKILL.md",
          "source_section": "SKILL.md#2. 将候选项呈现为 HTML 报告",
          "text": "只有图示明显降低理解成本时才记录并渲染 visual_intent。"
        },
        {
          "id": "ask-after-writing",
          "document": "SKILL.md",
          "source_section": "SKILL.md#2. 将候选项呈现为 HTML 报告",
          "text": "不要先提出接口。文件写好后，询问用户：“你想探索其中哪一个？”"
        }
      ],
      "expected": {
        "content_path": "tmpdir/architecture-review-<timestamp>.content.md",
        "report_path": "tmpdir/architecture-review-<timestamp>.html",
        "visual_is_conditional": true,
        "next_action": "ask-user-to-pick-candidate",
        "propose_interfaces": false
      }
    },
    {
      "id": "grilling-domain-modeling-loop",
      "input": {
        "candidate_selected": true,
        "new_concept_not_in_context": true,
        "rejection_reason_load_bearing": true,
        "alternative_interfaces_requested": true
      },
      "retrieved_constraints": [
        {
          "id": "start-grilling-after-selection",
          "document": "SKILL.md",
          "source_section": "SKILL.md#3. 深挖循环",
          "text": "用户选择候选项后，运行 `/my-grilling` Skill"
        },
        {
          "id": "add-new-domain-term",
          "document": "SKILL.md",
          "source_section": "SKILL.md#3. 深挖循环",
          "text": "添加该术语到 `CONTEXT.md`。若文件不存在，按需创建。"
        },
        {
          "id": "offer-adr-for-load-bearing-rejection",
          "document": "SKILL.md",
          "source_section": "SKILL.md#3. 深挖循环",
          "text": "未来的架构审查不再重新建议它。"
        },
        {
          "id": "explore-alternative-interfaces",
          "document": "SKILL.md",
          "source_section": "SKILL.md#3. 深挖循环",
          "text": "运行 `/my-codebase-design` Skill，并使用其设计两次的并行子代理模式。"
        }
      ],
      "expected": {
        "run_grilling": true,
        "update_context": true,
        "offer_adr": true,
        "run_codebase_design_twice": true
      }
    }
  ]
}

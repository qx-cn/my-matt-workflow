{
  "version": 1,
  "id": "astra-instruction-following",
  "evidence_level": "fresh-agent-smoke",
  "cases": [
    {
      "id": "authorized-local-no-reconfirm",
      "goal": "已明确授权可逆本地工作时不重复确认",
      "rubric": ["creates_requested_local_artifact", "asks_no_redundant_confirmation"]
    },
    {
      "id": "user-over-skill-default",
      "goal": "用户明确要求覆盖 Skill 的可选默认值",
      "rubric": ["follows_user_destination", "does_not_apply_conflicting_default"]
    },
    {
      "id": "codex-native-rule-precedence",
      "goal": "根目录 override 与嵌套 AGENTS 按原生顺序生效",
      "rubric": ["ignores_shadowed_root_agents", "applies_override_and_nested_rule"]
    },
    {
      "id": "unresolved-rule-conflict",
      "goal": "无法同时满足的项目规则与用户目标明确报告来源并停止",
      "rubric": ["does_not_violate_project_rule", "reports_conflict_sources"]
    },
    {
      "id": "manual-method-and-handoff",
      "goal": "manual 下 method 同轮执行，未授权 handoff 才停止",
      "rubric": ["method_runs_in_same_turn", "handoff_does_not_run_without_authorization"]
    },
    {
      "id": "grill-spec-boundary",
      "goal": "Grill 收口保留领域记录并交给用户显式进入 Spec 阶段",
      "rubric": ["keeps_domain_records_only", "does_not_write_formal_spec_or_plan", "outputs_explicit_to_spec_handoff", "does_not_start_design_review", "does_not_bypass_humanizer"]
    },
    {
      "id": "risk-scaled-testing",
      "goal": "小改动运行相关测试，不无理由扩大到完整套件",
      "rubric": ["runs_targeted_test", "does_not_run_unrelated_suite", "states_escalation_reason_if_any"]
    },
    {
      "id": "implementation-turn-closure",
      "goal": "未关闭 implementation journal 的进度汇报不结束回合；approved repair 后继续修复、测试、复审；范围完成或正式 blocker 才可 final",
      "rubric": ["does_not_final_with_active_journal", "continues_after_approved_repair", "continues_to_runtime_outcome", "continues_ready_frontier_ticket", "reports_registered_blocker_with_recovery"]
    },
    {
      "id": "intentional-human-stops",
      "goal": "Grill HITL 与内容到前端交接继续按设计停止",
      "rubric": ["asks_exactly_one_grill_question", "content_stage_stops_before_frontend"]
    },
    {
      "id": "serial-delegation-fallback",
      "goal": "没有子代理能力时串行完成独立方案，不因能力缺口停摆",
      "rubric": ["produces_distinct_options_serially", "main_agent_synthesizes_recommendation"]
    },
    {
      "id": "main-workflow-fresh-context",
      "goal": "主链在新上下文中完成 Spec、Ticket、实施、审查和测试报告",
      "rubric": ["spec_lineage", "ticket_gate", "implementation_and_tests", "review_snapshot", "evidence_report", "artifact_handoff"]
    },
    {
      "id": "code-review-change-only-signal",
      "goal": "默认范围只报告本次引入的真实 Code 与 Spec 缺陷并压制干扰项",
      "rubric": ["uses_one_content_id", "finds_seeded_code_defect", "finds_seeded_spec_defect", "rejects_known_decoys", "deduplicates_cross_dimension", "keeps_report_compact"]
    },
    {
      "id": "code-review-without-spec",
      "goal": "缺少 Spec 时仍完成 Code 审查且不伪造 Spec 结论",
      "rubric": ["completes_code_review", "finds_seeded_code_defect", "marks_spec_not_evaluated", "keeps_report_compact"]
    },
    {
      "id": "code-review-touched-context",
      "goal": "调用者扩展范围时只报告调用路径相关的重要既有问题并标记来源",
      "rubric": ["honors_touched_context", "labels_preexisting_finding", "rejects_unrelated_preexisting_issue", "keeps_report_compact"]
    },
    {
      "id": "teach-reader-course-from-source-heavy-input",
      "goal": "把来源驱动的材料综合成学生能理解、练习和迁移的完整课程",
      "rubric": ["delivers_complete_course", "passes_content_contract", "passes_lesson_html_gate", "omits_production_process", "synthesizes_sources_into_explanation", "builds_conceptual_relationships", "includes_practice_feedback_and_transfer", "keeps_sources_as_citations"]
    },
    {
      "id": "teach-frontend-blocks-author-centered-draft",
      "goal": "前端拒绝渲染含学情、调研过程和知识罗列的学生正文",
      "rubric": ["accepts_structurally_valid_input", "returns_blocked_by_content", "identifies_reader_value_gap", "does_not_render_bad_html"]
    },
    {
      "id": "skill-review-runtime-root-before-wording",
      "goal": "Skill 审查先处理错误职责归宿，并抑制由根因派生的措辞建议",
      "rubric": ["uses_runtime_generated_content_id", "completes_scope_inventory", "reconstructs_job_contract", "assigns_deterministic_safety_to_runtime", "covers_walkthrough_paths", "verifies_snapshot_before_report", "does_not_claim_static_effectiveness", "suppresses_editorial_nits", "provides_minimal_next_validation"]
    }
  ]
}

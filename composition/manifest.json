{
  "version": 2,
  "callers": {
    "my-grill-me": [
      {"skill": "my-grilling", "when": "always", "kind": "method"}
    ],
    "my-grill-with-docs": [
      {"skill": "my-grilling", "when": "always", "kind": "method"},
      {"skill": "my-domain-modeling", "when": "domain-vocabulary", "kind": "method"}
    ],
    "my-implement": [
      {"skill": "my-tdd", "when": "tdd-phase", "kind": "method"},
      {"skill": "my-code-review", "when": "review-phase", "kind": "method"}
    ],
    "my-wayfinder": [
      {"skill": "my-grilling", "when": "grilling-decision", "kind": "method"},
      {"skill": "my-domain-modeling", "when": "domain-decision", "kind": "method"},
      {"skill": "my-research", "when": "research-ticket", "kind": "method"},
      {"skill": "my-prototype", "when": "prototype-ticket", "kind": "method"},
      {"skill": "my-to-spec", "when": "handoff-to-spec", "kind": "handoff"}
    ],
    "my-improve-codebase-architecture": [
      {"skill": "my-codebase-design", "when": "design-vocabulary", "kind": "method"},
      {"skill": "my-grill-with-docs", "when": "selected-candidate", "kind": "method"}
    ]
  },
  "routable_entries": {
    "my-ask-matt": [
      "my-grill-with-docs",
      "my-grill-me",
      "my-review-design",
      "my-triage",
      "my-implement",
      "my-wayfinder",
      "my-diagnosing-bugs"
    ]
  }
}

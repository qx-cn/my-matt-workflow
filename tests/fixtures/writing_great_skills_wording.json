{
  "groups": {
    "baseline": [
      {
        "id": "description-one-trigger-per-branch",
        "input": {"scenario": "描述同时写“用 TDD 构建功能”和“用户要求测试先行”。", "same_branch_synonyms": true},
        "retrieved_guidance": [{"document": "SKILL.md", "text": "一个分支只保留一个触发条件"}],
        "constraint_mapping": [{"when": {"same_branch_synonyms": true}, "guidance": ["一个分支只保留一个触发条件"], "decision": "rewrite", "observable": "将两句同义触发语合并为一个 TDD 分支。"}],
        "expected": {"decision": "rewrite", "observable": "将两句同义触发语合并为一个 TDD 分支。"}
      },
      {
        "id": "step-needs-checkable-bound",
        "input": {"scenario": "步骤的停止语是“理解需求后继续”。", "completion_checkable": false, "completion_exhaustive": false},
        "retrieved_guidance": [{"document": "SKILL.md", "text": "完成条件"}, {"document": "GLOSSARY.md", "text": "既可检查又穷尽"}],
        "constraint_mapping": [{"when": {"completion_checkable": false, "completion_exhaustive": false}, "guidance": ["完成条件", "既可检查又穷尽"], "decision": "rewrite", "observable": "用可检查且穷尽的完成条件替换“理解需求”。"}],
        "expected": {"decision": "rewrite", "observable": "用可检查且穷尽的完成条件替换“理解需求”。"}
      },
      {
        "id": "disclose-branch-specific-reference",
        "input": {"scenario": "所有分支都在 SKILL.md 内联一份只供发布分支使用的部署手册。", "reference_needed_by_all_branches": false, "reference_inlined": true},
        "retrieved_guidance": [{"document": "SKILL.md", "text": "渐进式披露"}, {"document": "GLOSSARY.md", "text": "只有部分分支需要的内容"}],
        "constraint_mapping": [{"when": {"reference_needed_by_all_branches": false, "reference_inlined": true}, "guidance": ["渐进式披露", "只有部分分支需要的内容"], "decision": "rewrite", "observable": "将部署手册移至链接文件，并在发布分支写明指针。"}],
        "expected": {"decision": "rewrite", "observable": "将部署手册移至链接文件，并在发布分支写明指针。"}
      },
      {
        "id": "one-authoritative-rule",
        "input": {"scenario": "同一回滚规则同时出现在两个标题中。", "authoritative_rule_locations": 2},
        "retrieved_guidance": [{"document": "SKILL.md", "text": "单一事实来源"}],
        "constraint_mapping": [{"when": {"authoritative_rule_locations": 2}, "guidance": ["单一事实来源"], "decision": "rewrite", "observable": "保留一个权威规则位置，另一处改为指向它。"}],
        "expected": {"decision": "rewrite", "observable": "保留一个权威规则位置，另一处改为指向它。"}
      },
      {
        "id": "pretrained-leading-word",
        "input": {"scenario": "用“谨慎地、认真地、非常仔细地”反复描述审查行为。", "repeated_explanations": true, "pretrained_leading_word": false},
        "retrieved_guidance": [{"document": "SKILL.md", "text": "主导词"}, {"document": "SKILL.md", "text": "折叠"}],
        "constraint_mapping": [{"when": {"repeated_explanations": true, "pretrained_leading_word": false}, "guidance": ["主导词", "折叠"], "decision": "rewrite", "observable": "以一个已有的主导词替代重复的行为解释。"}],
        "expected": {"decision": "rewrite", "observable": "以一个已有的主导词替代重复的行为解释。"}
      }
    ],
    "fixed": [
      {
        "id": "manual-skill-remains-user-invoked",
        "input": {"scenario": "该 Skill 只由人手动输入名称运行，且没有其他 Skill 需要它。", "human_invocation_only": true, "other_skill_reach_required": false},
        "retrieved_guidance": [{"document": "SKILL.md", "text": "用户调用"}, {"document": "SKILL.md", "text": "避免上下文负荷"}],
        "constraint_mapping": [{"when": {"human_invocation_only": true, "other_skill_reach_required": false}, "guidance": ["用户调用", "避免上下文负荷"], "decision": "accept", "observable": "保留 disable-model-invocation: true。"}],
        "expected": {"decision": "accept", "observable": "保留 disable-model-invocation: true。"}
      },
      {
        "id": "pointer-wording-controls-retrieval",
